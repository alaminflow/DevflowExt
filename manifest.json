{
  "manifest_version": 3,
  "name": "DevFlow",
  "version": "1.0.0",
  "key": "",
  "description": "Your personal developer dashboard. Quick links, projects, todos, bookmarks, weather — all synced across devices.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://api.open-meteo.com/*",
    "https://ipapi.co/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://api.open-meteo.com https://ipapi.co;"
  },
  "oauth2": {
    "client_id": "931470206843-ifi7msb9q87n73huuancfh9cg2l40fdc.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "devflow@devflow.local",
      "strict_min_version": "109.0"
    }
  }
}
